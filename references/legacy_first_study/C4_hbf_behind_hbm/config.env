# C4: HBF behind HBM (H3). All 8 sites are HBM3 (409.6 GB/s); an HBF stack hangs off the HBM base
# die (D2D link 8 x 51.2 GB/s). The base die decodes the HBF window and forwards; HBF data comes back
# over the HBM PHY, so HBM and HBF bytes of each partition share one 51.2 GB/s link.
# Front end = HBM's 52.49 ns + 10 ns base-die decode / D2D hop (sweep with -- -gpgpu_hbf_frontend_latency_ns).
NAME=C4_behind_hbm
MEM=hbm3_slice8
RAM_SET=""                # Ramulator overrides of common/memory/<MEM>.py, e.g. "DATA_RATE_MBPS=12800,ns.nCL=25"
NEAR_PEAK_GBPS=409.6
HBF=1
ATTACH=2
HBF_CHANNELS=8
HBF_LINK_GBPS=51.2
PHY_GBPS=51.2
FRONTEND_NS=62.49
