# C1: HBM only. 8-SM GPU slice + half an HBM3 stack (8 channels, 409.6 GB/s, Ramulator).
# Every byte (weights, KV cache, activations) lives in HBM. The trace is the same as for C2-C4
# (weights sit at their 256 GiB addresses); with the HBF tier disabled those decode to HBM.
NAME=C1_hbm_only
MEM=hbm3_slice8
RAM_SET=""                # Ramulator overrides of common/memory/<MEM>.py, e.g. "DATA_RATE_MBPS=12800,ns.nCL=25"
NEAR_PEAK_GBPS=409.6
HBF=0
