# GPGPU-Sim built-in DRAM model of HBF-Sim's qwen3.config (A100-profile HBM2-like timing, 8 channels,
# 16 B bus, burst 2, 1512 MHz DRAM clock from -gpgpu_clock_domains = 387 GB/s). Appended after the GPU
# config only for configurations with MEM=builtin (C2_hbf_dram/legacy_paper). Ignored by Ramulator runs.
-dram_latency 190
-gpgpu_dram_scheduler 1
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 16
-gpgpu_dram_burst_length 2
-dram_data_command_freq_ratio 2
-dram_dual_bus_interface 1
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1
