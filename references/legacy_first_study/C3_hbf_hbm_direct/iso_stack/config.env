# C3 (iso-stack, DASH "DirectOnly"): HBM3 (8 ch, 409.6 GB/s) and HBF (8 ch x 51.2 GB/s) each on
# their own GPU PHYs; the host/driver places weights in the HBF address window.
NAME=C3_iso_stack
MEM=hbm3_slice8
RAM_SET=""                # Ramulator overrides of common/memory/<MEM>.py, e.g. "DATA_RATE_MBPS=12800,ns.nCL=25"
NEAR_PEAK_GBPS=409.6
HBF=1
ATTACH=1
HBF_CHANNELS=8
HBF_LINK_GBPS=51.2
PHY_GBPS=0
FRONTEND_NS=52.49
