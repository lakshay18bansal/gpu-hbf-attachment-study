# C3 (iso-shoreline, FlashAccel "CLI"): the slice's 8 memory sites are split 4 HBM + 4 HBF.
# HBM3 at half bandwidth (3.2 Gb/s, 204.8 GB/s, same ns timings) + HBF 4 ch x 51.2 GB/s.
NAME=C3_iso_shoreline
MEM=hbm3_slice8_half
RAM_SET=""                # Ramulator overrides of common/memory/<MEM>.py, e.g. "DATA_RATE_MBPS=12800,ns.nCL=25"
NEAR_PEAK_GBPS=204.8
HBF=1
ATTACH=1
HBF_CHANNELS=4
HBF_LINK_GBPS=51.2
PHY_GBPS=0
FRONTEND_NS=52.49
