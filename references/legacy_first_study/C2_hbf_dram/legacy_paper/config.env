# C2-legacy: HBF-Sim exactly as in its paper's Qwen3-1.7B run (validation only): GPGPU-Sim's built-in
# DRAM (qwen3.config timings), HBF shares the DRAM queue and credits (attach 0), L2 bypass,
# 16 channels x 192 GB/s, 512 sub-arrays / active slots, 4096 admission entries.
NAME=C2_legacy_paper
MEM=builtin
NEAR_PEAK_GBPS=387
HBF=1
ATTACH=0
HBF_CHANNELS=16
HBF_LINK_GBPS=192
DERIVE=0
