# C2: HBF + conventional DRAM. The HBM sites are replaced by an HBF stack on its own PHY
# (8 channels x 51.2 GB/s); KV cache / activations live in GDDR6 (8 x16 channels, 224 GB/s).
NAME=C2_hbf_dram
MEM=gddr6_slice8
RAM_SET=""                # Ramulator overrides of common/memory/<MEM>.py, e.g. "DATA_RATE_MBPS=12800,ns.nCL=25"
NEAR_PEAK_GBPS=224
HBF=1
ATTACH=1
HBF_CHANNELS=8
HBF_LINK_GBPS=51.2
PHY_GBPS=0
FRONTEND_NS=52.49
