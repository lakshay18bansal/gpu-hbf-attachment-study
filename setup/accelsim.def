Bootstrap: docker
From: nvidia/cuda:12.8.1-devel-ubuntu24.04

# Apptainer image with everything needed to build and run this repository
# (no GPU is needed: the simulator is trace-driven and only uses the CUDA toolkit at build time).
#   apptainer build accelsim.sif setup/accelsim.def        (needs root or --fakeroot)
#   HBF_CONTAINER=$PWD/accelsim.sif simulator/build.sh

%labels
    Description Accel-Sim + Ramulator 2 + HBF-Sim build/run environment (hbf-gpu-4arch)
    CUDA 12.8

%environment
    export CUDA_HOME=/usr/local/cuda
    export CUDA_INSTALL_PATH=/usr/local/cuda
    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential g++ cmake make git bison flex xutils-dev zlib1g-dev libzstd-dev libglu1-mesa-dev \
        python3 python3-dev python3-pip python3-venv python3-yaml \
        time xz-utils bc file ca-certificates
    rm -rf /var/lib/apt/lists/*

%runscript
    exec "$@"

%test
    nvcc --version
    cmake --version
    python3 --version
