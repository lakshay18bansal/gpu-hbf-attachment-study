+void hbf_controller_t::prefetch_enqueue(
+    const std::vector<unsigned long long> &pages) {
+  if (!m_lhb.enabled()) return;
+  m_pf_stream.insert(m_pf_stream.end(), pages.begin(), pages.end());
+  n_pf_enqueued += pages.size();
+}
+
+// Streaming prefetcher: keep up to m_pf_window prefetched-but-undemanded
+// pages in flight or resident.  Prefetch reads are scheduled after demand
+// reads (schedule_operations) and leave room in the MSHR for demand.
+void hbf_controller_t::issue_prefetches() {
+  if (!m_lhb.enabled()) return;
+  unsigned long long current_cycle =
+      m_gpu->gpu_sim_cycle + m_gpu->gpu_tot_sim_cycle;
+  unsigned max_q = m_config->hbf_max_outstanding;
+  unsigned pf_cap = max_q == 0 ? ~0u : max_q - max_q / 4;
+  while (!m_pf_stream.empty() && m_pf_undemanded < m_pf_window &&
+         m_mshr.size() + m_write_buffer.size() < pf_cap) {
+    unsigned long long page = m_pf_stream.front();
+    m_pf_stream.pop_front();
+    if (m_mshr.count(page) || m_lhb.contains(page)) {
+      n_pf_skipped++;
+      continue;
+    }
+    mshr_entry_t entry = {};
+    entry.phys_page = page;
+    entry.channel_id = channel_of_page(page);
+    entry.op_state = OP_WAITING;
+    entry.is_prefetch = true;
+    entry.first_arrival_cycle = current_cycle;
+    entry.first_arrival_tick = m_hbf_tick;
+    if (m_ftl) {
+      hbf_phys_addr_t phys = m_ftl->translate(page, false);
+      if (!phys.valid() || phys.subarray >= m_num_subarrays ||
+          !m_channels[entry.channel_id]->owns_subarray(phys.subarray))
+        fail_fast("FTL prefetch mapping violates channel/subarray affinity",
+                  page);
+      entry.subarray_id = phys.subarray;
+      entry.block_id = phys.block;
+      entry.page_offset = phys.page;
+    } else {
+      direct_physical_address(page, entry.channel_id, &entry.subarray_id,
+                              &entry.block_id, &entry.page_offset);
+    }
+    m_mshr[page] = entry;
+    m_mshr_queue.push_back(page);
+    m_pf_undemanded++;
+    m_pf_only_entries++;
+  }
+}
