@@ -1568,6 +1608,55 @@ void gpgpu_sim_config::init_clock_domains(void) {
          core_period, icnt_period, l2_period, dram_period);
 }
 
+// Convert an HBF ns timer to DRAM ticks of the run's DRAM clock.
+static unsigned hbf_ns_to_ticks(const char *name, double ns,
+                                double dram_freq_hz) {
+  double ticks = ns * dram_freq_hz * 1e-9;
+  if (ticks > 4294967295.0) {
+    fprintf(stderr, "HBF: %s_ns=%.1f is %.0f DRAM ticks, above UINT_MAX\n",
+            name, ns, ticks);
+    exit(1);
+  }
+  unsigned long long t = llround(ticks);
+  return t > 0 ? (unsigned)t : 1;  // a positive time is never zero ticks
+}
+
+void memory_config::resolve_hbf_timings(double dram_freq_hz) {
+  hbf_dram_freq_hz = dram_freq_hz;
+  struct {
+    const char *name;
+    double ns;
+    unsigned *ticks;
+  } timers[] = {
+      {"tR", hbf_tR_ns, &hbf_tR},
+      {"tPROG", hbf_tPROG_ns, &hbf_tPROG},
+      {"tBERS", hbf_tBERS_ns, &hbf_tBERS},
+      {"buffer_hit_latency", hbf_buffer_hit_latency_ns,
+       &hbf_buffer_hit_latency},
+      {"cache_hit_latency", hbf_cache_hit_latency_ns, &hbf_cache_hit_latency},
+      {"write_agg_timeout", hbf_write_agg_timeout_ns, &hbf_write_agg_timeout},
+      {"write_drain_maxwait", hbf_write_drain_maxwait_ns,
+       &hbf_write_drain_maxwait},
+      {"read_agg_window", hbf_read_agg_window_ns, &hbf_read_agg_window},
+      {"idle_drain_quiet", hbf_idle_drain_quiet_ns, &hbf_idle_drain_quiet},
+  };
+  std::string line;
+  char buf[160];
+  for (auto &t : timers) {
+    bool from_ns = t.ns > 0.0;
+    if (from_ns) *t.ticks = hbf_ns_to_ticks(t.name, t.ns, dram_freq_hz);
+    // "(ns)" marks a value set by the _ns option, "(ticks)" by the tick one.
+    snprintf(buf, sizeof(buf), " %s=%u ticks/%.1f ns%s", t.name, *t.ticks,
+             *t.ticks * 1e9 / dram_freq_hz, from_ns ? "(ns)" : "(ticks)");
+    line += buf;
+  }
+  if (hbf_enabled)
+    printf("GPGPU-Sim uArch: HBF timings @ DRAM clock %.3f MHz (%s):%s\n",
+           dram_freq_hz / 1e6,
+           ramulator_enabled ? "Ramulator tCK" : "-gpgpu_clock_domains",
+           line.c_str());
+}
+
 void gpgpu_sim::reinit_clock_domains(void) {
   core_time = 0;
   dram_time = 0;
