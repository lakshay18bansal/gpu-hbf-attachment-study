     power_config::init();
     Trace::init();
 
@@ -608,7 +629,8 @@ class gpgpu_sim_config : public power_config,
     m_valid = true;
   }
   unsigned get_core_freq() const { return core_freq; }
-  unsigned get_dram_freq() const { return dram_freq; }
+  // double: HBM3/Ramulator clocks above 4.29 GHz overflow an unsigned (Hz).
+  double get_dram_freq() const { return dram_freq; }
   unsigned num_shader() const { return m_shader_config.num_shader(); }
