+new_addr_type linear_to_raw_address_translation::channel_address(
+    new_addr_type addr) const {
+  if (!gap) {
+    return addrdec_packbits(~addrdec_mask[CHIP], addr, 64, 0);
+  } else {
+    // see addrdec_tlx: channel = (addr >> ADDR_CHIP_S) % m_n_channel
+    new_addr_type channel_addr = ((addr >> ADDR_CHIP_S) / m_n_channel)
+                                 << ADDR_CHIP_S;
+    channel_addr |= addr & ((1ULL << ADDR_CHIP_S) - 1);
+    return channel_addr;
+  }
+}
