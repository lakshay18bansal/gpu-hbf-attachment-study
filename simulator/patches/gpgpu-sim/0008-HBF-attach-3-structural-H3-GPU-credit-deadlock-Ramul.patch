+// attach 3: the GPU<->HBM link.  May go negative by one transfer (burst).
+bool memory_partition_unit::h3_link_take(unsigned bytes) {
+  if (m_phy_rate <= 0) return true;
+  if (m_phy_tokens <= 0.0) return false;
