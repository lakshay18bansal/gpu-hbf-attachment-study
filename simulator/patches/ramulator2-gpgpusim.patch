diff --git a/src/ramulator/gpgpusim/gpgpusim.h b/src/ramulator/gpgpusim/gpgpusim.h
new file mode 100644
index 0000000..593d24f
--- /dev/null
+++ b/src/ramulator/gpgpusim/gpgpusim.h
@@ -0,0 +1,64 @@
+// Ramulator components for running Ramulator as the DRAM model of
+// GPGPU-Sim / Accel-Sim (the bridge lives in Accel-Sim:
+// gpu-simulator/gpgpu-sim/src/gpgpu-sim/ramulator_dram.cc).
+//
+// Components (all selectable from a Ramulator config):
+//   frontend          GPGPUSim         External-style frontend plus the fixed
+//                                      latency of the GPU memory controller
+//                                      front end (param fixed_latency_ns)
+//   controller_plugin GPGPUSimCounter  per-channel command counters read by
+//                                      Accel-Sim for its stats and AccelWattch
+//   addr_mapper       GPUBgCoBaRo      GPU-style mapping inside a channel
+//
+// This header only exposes plain data and functions; the registered
+// component classes stay inside libramulator.
+
+#ifndef RAMULATOR_GPGPUSIM_GPGPUSIM_H
+#define RAMULATOR_GPGPUSIM_GPGPUSIM_H
+
+#include <string>
+#include <vector>
+
+namespace Ramulator {
+
+class IFrontEnd;
+
+namespace GPGPUSim {
+
+// Filled by one GPGPUSimCounter plugin (one per controller = channel).
+struct ChannelInfo {
+  int channel = -1;
+
+  // Command counts since the start of the simulation
+  unsigned long long n_act = 0;
+  unsigned long long n_pre = 0;  // PREpb + PREab + auto-precharges (RDA/WRA)
+  unsigned long long n_rd = 0;   // RD + RDA
+  unsigned long long n_wr = 0;   // WR + WRA
+  unsigned long long n_ref = 0;  // REFab + REFpb
+  unsigned long long n_issued = 0;
+
+  // Device / controller description (from the DRAM spec and controller)
+  std::vector<std::string> level_names;  // "Channel", "BankGroup", ...
+  std::vector<int> level_sizes;
+  int internal_prefetch = 1;
+  int tx_bytes = 0;
+  int burst_ticks = 1;  // data-bus ticks per RD/WR (nBL)
+  int data_buses = 1;   // independent data buses (HBM pseudo-channels)
+  int read_buffer_size = 0;
+  int write_buffer_size = 0;
+  float tck_ns = 0;  // one controller tick
+  std::string standard;
+  std::string addr_mapper;
+};
+
+// One entry per GPGPUSimCounter created, in creation order (= channel order).
+// Clear it before creating a memory system.
+std::vector<ChannelInfo*>& channels();
+
+// Fixed front-end latency of a GPGPUSim frontend; -1 for any other frontend.
+float fixed_latency_ns(IFrontEnd* frontend);
+
+}  // namespace GPGPUSim
+}  // namespace Ramulator
+
+#endif  // RAMULATOR_GPGPUSIM_GPGPUSIM_H
diff --git a/src/ramulator/gpgpusim/gpgpusim_counter.cpp b/src/ramulator/gpgpusim/gpgpusim_counter.cpp
new file mode 100644
index 0000000..6a749a1
--- /dev/null
+++ b/src/ramulator/gpgpusim/gpgpusim_counter.cpp
@@ -0,0 +1,88 @@
+// GPGPUSimCounter controller plugin: counts the DRAM commands one controller
+// (= one channel) issues and describes the device, so Accel-Sim can print
+// per-channel DRAM stats and feed AccelWattch (which charges energy per read,
+// write and precharge).
+
+#include "ramulator/base/base.h"
+#include "ramulator/controller/controller_base.h"
+#include "ramulator/controller/plugin/i_controller_plugin.h"
+#include "ramulator/dram/dram_spec.h"
+#include "ramulator/gpgpusim/gpgpusim.h"
+
+namespace Ramulator {
+
+namespace GPGPUSim {
+
+std::vector<ChannelInfo*>& channels() {
+  static std::vector<ChannelInfo*> registry;
+  return registry;
+}
+
+}  // namespace GPGPUSim
+
+class GPGPUSimCounter : public IControllerPlugin, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IControllerPlugin, GPGPUSimCounter, "GPGPUSimCounter")
+
+ private:
+  enum Kind { OTHER, ACT, PRE, RD, RDA, WR, WRA, REF };
+  std::vector<Kind> m_kind;  // indexed by command id
+  GPGPUSim::ChannelInfo m_info;
+
+ public:
+  void init() override { GPGPUSim::channels().push_back(&m_info); }
+
+  void setup(IFrontEnd* frontend, IMemorySystem* memory_system) override {
+    auto* ctrl = cast_parent<ControllerBase>();
+    const DRAMSpec& spec = *ctrl->m_device.m_spec;
+
+    m_kind.assign(spec.command_names.size(), OTHER);
+    for (size_t i = 0; i < spec.command_names.size(); i++) {
+      const std::string& c = spec.command_names[i];
+      if (c == "ACT")
+        m_kind[i] = ACT;
+      else if (c.rfind("PRE", 0) == 0)
+        m_kind[i] = PRE;
+      else if (c == "RD")
+        m_kind[i] = RD;
+      else if (c == "RDA")
+        m_kind[i] = RDA;
+      else if (c == "WR")
+        m_kind[i] = WR;
+      else if (c == "WRA")
+        m_kind[i] = WRA;
+      else if (c.rfind("REF", 0) == 0)
+        m_kind[i] = REF;
+    }
+
+    m_info.channel = ctrl->m_channel_id;
+    m_info.level_names = spec.level_names;
+    m_info.level_sizes.assign(spec.organization.level_sizes.begin(),
+                              spec.organization.level_sizes.end());
+    m_info.internal_prefetch = spec.internal_prefetch_size;
+    m_info.tx_bytes = ctrl->get_tx_bytes();
+    m_info.burst_ticks = spec.has_timing("nBL") ? spec.get_timing_value("nBL") : 1;
+    m_info.data_buses = spec.has_level("PseudoChannel") ? spec.get_level_size("PseudoChannel") : 1;
+    m_info.read_buffer_size = ctrl->get_read_buffer_size();
+    m_info.write_buffer_size = ctrl->get_write_buffer_size();
+    m_info.tck_ns = ctrl->get_tCK();
+    m_info.standard = spec.standard_name;
+    m_info.addr_mapper = ctrl->m_addr_mapper->m_impl->get_name();
+  }
+
+  void on_issue(const Request& req) override {
+    m_info.n_issued++;
+    if (req.command < 0 || req.command >= (int)m_kind.size()) return;
+    switch (m_kind[req.command]) {
+      case ACT: m_info.n_act++; break;
+      case PRE: m_info.n_pre++; break;
+      case RD: m_info.n_rd++; break;
+      case RDA: m_info.n_rd++; m_info.n_pre++; break;  // auto-precharge closes the row
+      case WR: m_info.n_wr++; break;
+      case WRA: m_info.n_wr++; m_info.n_pre++; break;
+      case REF: m_info.n_ref++; break;
+      default: break;
+    }
+  }
+};
+
+}  // namespace Ramulator
diff --git a/src/ramulator/gpgpusim/gpgpusim_frfcfs.cpp b/src/ramulator/gpgpusim/gpgpusim_frfcfs.cpp
new file mode 100644
index 0000000..8d12687
--- /dev/null
+++ b/src/ramulator/gpgpusim/gpgpusim_frfcfs.cpp
@@ -0,0 +1,79 @@
+// GPGPUSimFRFCFS scheduler: classic FR-FCFS (Rixner et al., ISCA 2000), the
+// policy of GPGPU-Sim's built-in DRAM scheduler (dram_sched.cc):
+//   1. an open row is not closed while requests that hit it are queued
+//      (GPGPU-Sim keeps serving a row until its queue "bin" is empty),
+//   2. among the rest: commands that can issue now first, row hits first,
+//      then the oldest request.
+// Ramulator's FRFCFS ranks only by "can issue now" then age, so an older
+// request to another row can close a row that still has queued hits;
+// FRFCFSRowHit only protects hits older than the closing request.
+
+#include <vector>
+
+#include "ramulator/controller/controller_base.h"
+#include "ramulator/controller/scheduler/i_scheduler.h"
+
+namespace Ramulator {
+
+class GPGPUSimFRFCFS : public IScheduler, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IScheduler, GPGPUSimFRFCFS, "GPGPUSimFRFCFS")
+
+  ControllerBase* m_ctrl = nullptr;
+  std::vector<char> m_bank_has_hit;  // per flat bank: a queued request hits the open row
+
+ public:
+  void init() override {
+    m_ctrl = cast_parent<ControllerBase>();
+    m_bank_has_hit.assign(m_ctrl->m_device.m_bank_nodes.size(), 0);
+  }
+
+  ReqBuffer::iterator get_best_request(ReqBuffer& buffer, RequestFilterRef filter) override {
+    if (buffer.size() == 0) return buffer.end();
+
+    // Pass 1: next command of every request, and which banks have queued row hits
+    std::fill(m_bank_has_hit.begin(), m_bank_has_hit.end(), 0);
+    for (auto it = buffer.begin(); it != buffer.end(); it++) {
+      it->command = m_ctrl->get_preq_command(it->final_command, it->addr_vec);
+      if (is_row_hit(*it)) {
+        int bank = m_ctrl->m_device.get_flat_bank_id(it->addr_vec);
+        if (bank >= 0 && bank < (int)m_bank_has_hit.size()) m_bank_has_hit[bank] = 1;
+      }
+    }
+
+    // Pass 2: best candidate = (ready, row hit, oldest)
+    auto best = buffer.end();
+    bool best_ready = false, best_hit = false;
+    for (auto it = buffer.begin(); it != buffer.end(); it++) {
+      if (filter && !filter(*it)) continue;
+      if (closes_row_with_hits(*it)) continue;
+      bool ready = m_ctrl->check_timing(it->command, it->addr_vec);
+      bool hit = is_row_hit(*it);
+      if (best == buffer.end() || ready > best_ready ||
+          (ready == best_ready && (hit > best_hit ||
+                                   (hit == best_hit && it->arrive < best->arrive)))) {
+        best = it;
+        best_ready = ready;
+        best_hit = hit;
+      }
+    }
+    return best;
+  }
+
+ private:
+  // The request's next command is its final column command on an open row
+  bool is_row_hit(const Request& req) const {
+    return req.command == req.final_command &&
+           m_ctrl->m_device.check_rowbuffer_hit(req.final_command, req.addr_vec, m_ctrl->m_clk);
+  }
+
+  // The request's next command would close a row that queued requests still hit
+  bool closes_row_with_hits(const Request& req) const {
+    const auto& spec = *m_ctrl->m_device.m_spec;
+    if (!spec.command_meta[req.command].is_closing || req.command == req.final_command) return false;
+    if (spec.bank_targets[req.command] != BankTarget::Single) return false;
+    int bank = m_ctrl->m_device.get_flat_bank_id(req.addr_vec);
+    return bank >= 0 && bank < (int)m_bank_has_hit.size() && m_bank_has_hit[bank];
+  }
+};
+
+}  // namespace Ramulator
diff --git a/src/ramulator/gpgpusim/gpgpusim_frontend.cpp b/src/ramulator/gpgpusim/gpgpusim_frontend.cpp
new file mode 100644
index 0000000..fcabac6
--- /dev/null
+++ b/src/ramulator/gpgpusim/gpgpusim_frontend.cpp
@@ -0,0 +1,56 @@
+// GPGPUSim frontend: like the External frontend (the host simulator injects
+// requests and ticks the memory system), plus the fixed latency of the GPU
+// memory controller front end, which Accel-Sim applies before a request
+// reaches the Ramulator controller.
+
+#include "ramulator/base/param.h"
+#include "ramulator/frontend/i_frontend.h"
+#include "ramulator/gpgpusim/gpgpusim.h"
+
+namespace Ramulator {
+
+class GPGPUSimFrontEnd : public IFrontEnd, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IFrontEnd, GPGPUSimFrontEnd, "GPGPUSim")
+
+ public:
+  float m_fixed_latency_ns = 0;
+
+  void init() override {
+    RAMULATOR_PARSE_PARAM(m_clock_ratio, unsigned int, "clock_ratio").default_val(1);
+    RAMULATOR_PARSE_PARAM(m_fixed_latency_ns, float, "fixed_latency_ns").default_val(0.0f);
+    if (m_fixed_latency_ns < 0) {
+      throw std::runtime_error("GPGPUSim frontend: fixed_latency_ns must be >= 0");
+    }
+  }
+
+  void tick() override {}
+
+  bool is_finished() override { return false; }
+
+  bool receive_external_requests(int req_type_id, Addr_t addr, int source_id,
+                                 std::function<void(Request&)> callback,
+                                 int size_bytes) override {
+    return receive_external_requests(req_type_id, addr, source_id, -1,
+                                     std::move(callback), size_bytes);
+  }
+
+  bool receive_external_requests(int req_type_id, Addr_t addr, int source_id,
+                                 int ingress_id,
+                                 std::function<void(Request&)> callback,
+                                 int size_bytes) override {
+    Request req(addr, req_type_id, source_id, std::move(callback));
+    req.ingress_id = ingress_id;
+    req.size_bytes = size_bytes;
+    return m_memory_system->send(req);
+  }
+};
+
+namespace GPGPUSim {
+
+float fixed_latency_ns(IFrontEnd* frontend) {
+  auto* fe = dynamic_cast<GPGPUSimFrontEnd*>(frontend);
+  return fe ? fe->m_fixed_latency_ns : -1.0f;
+}
+
+}  // namespace GPGPUSim
+}  // namespace Ramulator
diff --git a/src/ramulator/gpgpusim/gpu_bg_co_ba_ro.cpp b/src/ramulator/gpgpusim/gpu_bg_co_ba_ro.cpp
new file mode 100644
index 0000000..f907bda
--- /dev/null
+++ b/src/ramulator/gpgpusim/gpu_bg_co_ba_ro.cpp
@@ -0,0 +1,60 @@
+// GPUBgCoBaRo address mapper: GPU-style mapping inside one channel.
+//
+// From the least significant bit of the (transaction-aligned) address:
+//   [PseudoChannel] [BankGroup] | Column | other levels (e.g. Sid, Bank) | Row
+// then every bank-level index is XORed with the low row bits.
+//
+// Consecutive 32B transactions rotate over pseudo-channels and bank groups, so
+// back-to-back column commands are tCCD_S apart instead of tCCD_L; the XOR
+// stops arrays aligned to large powers of two (e.g. a[], b[], c[]) from
+// fighting over one bank. Ramulator's built-in mappers put the column lowest,
+// which costs GPU streaming traffic 1.5-2.7x bandwidth on GDDR6.
+
+#include <algorithm>
+
+#include "ramulator/controller/addr_mapper/addr_mapper_base.h"
+#include "ramulator/controller/addr_mapper/i_addr_mapper.h"
+
+namespace Ramulator {
+
+class GPUBgCoBaRo : public IAddrMapper, public AddrMapperBase {
+  RAMULATOR_REGISTER_IMPLEMENTATION_DERIVED(IAddrMapper, GPUBgCoBaRo, AddrMapperBase, "GPUBgCoBaRo")
+
+  std::vector<int> m_low;  // m_addr_bits indices mapped below the column
+  std::vector<int> m_mid;  // between column and row
+
+ public:
+  void init() override {
+    AddrMapperBase::init();
+    const DRAMSpec& spec = *m_ctrl->m_device.m_spec;
+    for (const char* name : {"PseudoChannel", "BankGroup"}) {
+      if (spec.has_level(name)) m_low.push_back(spec.get_level_id(name) - 1);
+    }
+    for (int i = 0; i < m_row_idx; i++) {
+      if (std::find(m_low.begin(), m_low.end(), i) == m_low.end()) m_mid.push_back(i);
+    }
+  }
+
+  void apply(Request& req) override {
+    req.addr_vec.resize(m_num_mapped_levels + 1, -1);
+    Addr_t addr = req.intra_channel_addr >> m_tx_offset;
+    for (int i : m_low) {
+      req.addr_vec[i + 1] = slice_lower_bits(addr, m_addr_bits[i]);
+    }
+    req.addr_vec[m_col_idx + 1] = slice_lower_bits(addr, m_addr_bits[m_col_idx]);
+    for (int i : m_mid) {
+      req.addr_vec[i + 1] = slice_lower_bits(addr, m_addr_bits[i]);
+    }
+    req.addr_vec[m_row_idx + 1] = slice_lower_bits(addr, m_addr_bits[m_row_idx]);
+
+    // Permutation interleaving: XOR bank-level indices with the low row bits
+    int row = req.addr_vec[m_row_idx + 1], shift = 0;
+    for (int i = 0; i < m_row_idx; i++) {
+      if (m_addr_bits[i] == 0) continue;
+      req.addr_vec[i + 1] ^= (row >> shift) & ((1 << m_addr_bits[i]) - 1);
+      shift += m_addr_bits[i];
+    }
+  }
