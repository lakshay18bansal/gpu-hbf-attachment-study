# assembled by models/run.sh for C2 (C2_hbf_dram) / /home/lakshay/btp_work/hbf-gpu-4arch/workloads/vectoradd/hbf_rw512k/kernelslist.g / prefetch=off
# ---- base/hbfsim_qwen3.config (HBF-Sim artifact/configs/qwen3.config, verbatim)
# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 80

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_kernel_launch_latency  5000
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 1

# Compute Capability
-gpgpu_compute_capability_major 8
-gpgpu_compute_capability_minor 0

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
-gpgpu_n_clusters 8
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 8
-gpgpu_n_sub_partition_per_mchannel 4

# clock domains
#-gpgpu_clock_domains <Core Clock>:<Interconnect Clock>:<L2 Clock>:<DRAM Clock>
-gpgpu_clock_domains 1410:1410:1410:1512

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 80

-gpgpu_shader_core_pipeline 2048:32
-gpgpu_shader_cta 32
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4

# Instruction latencies and initiation intervals
# "ADD,MAX,MUL,MAD,DIV"
# All Div operations are executed on SFU unit
-ptx_opcode_latency_int 4,4,4,4,21
-ptx_opcode_initiation_int 2,2,2,2,2
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 2,2,2,2,4
-ptx_opcode_latency_dp 6,6,6,6,330
-ptx_opcode_initiation_dp 4,4,4,4,130
-ptx_opcode_latency_sfu 23
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 25
-ptx_opcode_initiation_tensor 16

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8
# register banks
-gpgpu_num_reg_banks 32
-gpgpu_reg_file_port_throughput 2

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>
# ** Optional parameter - Required when mshr_type==Texture Fifo
# In adaptive cache, we adaptively assign the remaining shared memory to L1 cache
# For more info, see https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,164
-gpgpu_unified_l1d_size 192
# L1 cache configuration
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:64,L:T:m:L:L,A:512:64,16:0,32
-gpgpu_l1_latency 34
-gpgpu_gmem_skip_L1D 1
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 0

# shared memory  configuration
-gpgpu_shmem_size 167936
-gpgpu_shmem_sizeDefault 167936
-gpgpu_shmem_per_block 49152
-gpgpu_smem_latency 28
# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 80

# L2 cache
-gpgpu_cache:dl2 S:128:128:16,L:B:m:L:X,A:192:4,32:0,32
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
-gpgpu_memory_partition_indexing 0

# 128 KB Inst.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:2:48,4
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Note, TEX is deprected since Volta, It is used for legacy apps only. Use L1D cache instead with .nc modifier or __ldg mehtod
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1

# memory partition latency config
-gpgpu_l2_rop_latency 200
-dram_latency 190

# dram sched config
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 64
-gpgpu_dram_return_queue_size 192

# dram model config
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 16
-gpgpu_dram_burst_length 2
-dram_data_command_freq_ratio 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Mem timing
-gpgpu_dram_timing_opt nbk=16:CCD=1:RRD=7:RCD=22:RAS=50:RP=22:RC=72:CL=22:WL=4:CDLR=5:WR=19:nbkgrp=4:CCDL=4:RTPL=7
-dram_dual_bus_interface 1

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

#-dram_seperate_write_queue_enable 1
#-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# power model configs, disable it untill we create a real energy model
-power_simulation_enabled 0

# tracing functionality
#-trace_enabled 1
#-trace_components WARP_SCHEDULER,SCOREBOARD
#-trace_sampling_core 0

-trace_opcode_latency_initiation_int 2,2
-trace_opcode_latency_initiation_sp 2,2
-trace_opcode_latency_initiation_dp 4,4
-trace_opcode_latency_initiation_sfu 20,8
-trace_opcode_latency_initiation_tensor 14,6

#execute branch insts on spec unit 1
#<enabled>,<num_units>,<max_latency>,<ID_OC_SPEC>,<OC_EX_SPEC>,<NAME>
-specialized_unit_1 1,4,4,4,4,BRA
-trace_opcode_latency_initiation_spec_op_1 4,4

#TEX unit, make fixed latency for all tex insts
-specialized_unit_2 1,4,200,4,4,TEX
-trace_opcode_latency_initiation_spec_op_2 200,4

#tensor unit
-specialized_unit_3 1,4,12,4,4,TENSOR
-trace_opcode_latency_initiation_spec_op_3 12,8

#UDP unit, for turing and above
-specialized_unit_4 1,4,4,4,4,UDP
-trace_opcode_latency_initiation_spec_op_4 4,1

-gpgpu_hbf_enabled 1
-gpgpu_hbf_base_addr 274877906944
-gpgpu_hbf_size 549755813888
-gpgpu_hbf_num_stacks 1
-gpgpu_hbf_stack_map 0
-gpgpu_hbf_latency 10000
-gpgpu_hbf_max_outstanding 4096
-gpgpu_hbf_use_phase2 1
-gpgpu_hbf_num_subarrays 512
-gpgpu_hbf_max_active 512
-gpgpu_hbf_tR 22680
-gpgpu_hbf_tPROG 302400
-gpgpu_hbf_tBERS 3024000
-gpgpu_hbf_mshr_enabled 1
-gpgpu_hbf_ftl_enabled 1
-gpgpu_hbf_overprovisioning 0.15
-gpgpu_hbf_wear_leveling_enabled 0
-gpgpu_hbf_num_channels 16
-gpgpu_hbf_allow_non_ocp_channels 0
-gpgpu_hbf_placement_mode 0
-gpgpu_hbf_channel_map 0
-gpgpu_hbf_channel_map_file ""
-gpgpu_hbf_channel_bw_gbps 192
-gpgpu_hbf_max_outstanding_writes 64
-gpgpu_hbf_media_mode 0
-gpgpu_hbf_blocks_per_zone 64
-gpgpu_hbf_zone_remap_enabled 0
-gpgpu_hbf_zone_remap_threshold 100
-gpgpu_hbf_write_buffer_entries 32
-gpgpu_hbf_write_agg_timeout 1000
-gpgpu_hbf_page_buffers 2
-gpgpu_hbf_scheduler 0
-gpgpu_hbf_write_drain_high 8
-gpgpu_hbf_write_drain_maxwait 20000
-gpgpu_hbf_buffer_hit_latency 10
-gpgpu_hbf_cache_entries 0
-gpgpu_hbf_cache_hit_latency 50
-gpgpu_hbf_buffer_enabled 1 # Per-subarray page buffer (default 1)
-gpgpu_hbf_read_mode 0
-gpgpu_hbf_read_agg_window 0
-gpgpu_hbf_read_agg_threshold 4096
-gpgpu_hbf_write_timeout_policy 0
-gpgpu_hbf_l2_policy 0
-gpgpu_hbf_trace_file ""
-gpgpu_hbf_trace_level 1

# ---- base/common.config
# Changes to HBF-Sim's Qwen3 config (base/hbfsim_qwen3.config) shared by C1-C4.
# Appended after hbfsim_qwen3.config and before each configuration's config.overrides.
# Everything not listed here (8 SMs, 1410 MHz core, caches, NoC, 8 memory partitions, address
# mapping, HBF device: 1 stack, 16 ch x 192 GB/s, 512 sub-arrays, 512 active, 4096 admission
# entries, MSHR, 2 page buffers, no page cache, FCFS) is HBF-Sim's value, unchanged.

# 1. DRAM/HBM comes from Ramulator (memory/hbm2e_slice8.py, the run folder's memory.yaml):
#    HBM2E 8 ch x 128 bit x 3024 Mbps = 387.07 GB/s at 1512 MHz, timings CL/RCD/RP 22, RC 72,
#    front end 134.75 ns = HBF-Sim's built-in DRAM. The runner adds
#    -gpgpu_ramulator_enabled 1 -gpgpu_ramulator_config ./memory.yaml.

# 2. GPU-side DRAM credits per partition = HBF-Sim's: 1 private x 4 sub-partitions
#    + (frfcfs queue 64 + return queue 192 - 3) shared = 257. Without this Ramulator's
#    own limit (2 x (64 + 64) = 256) would be used. C2 and C4 share these credits
#    between DRAM/HBM and HBF requests, as HBF-Sim does.
-gpgpu_dram_max_outstanding 257

# 3. HBF timers in ns. HBF-Sim gives them in DRAM ticks of its 1512 MHz clock; Ramulator's
#    tick is 661 ps (1512.86 MHz), so the ns values keep HBF-Sim's physical times exactly
#    (tick value / 1512 MHz). The tick options above stay as they were and are overridden.
-gpgpu_hbf_tR_ns 15000
-gpgpu_hbf_tPROG_ns 200000
-gpgpu_hbf_tBERS_ns 2000000
-gpgpu_hbf_buffer_hit_latency_ns 6.6138
-gpgpu_hbf_cache_hit_latency_ns 33.0688
-gpgpu_hbf_write_agg_timeout_ns 661.376
-gpgpu_hbf_write_drain_maxwait_ns 13227.513

# 4. No per-event HBF CSV (HBF-Sim's file path is already empty; level 0 = off).
-gpgpu_hbf_trace_level 0

# 5. GPGPU-Sim's deadlock check stays on, with a longer window: a run aborts when no instruction
#    commits for 20,000,000 core cycles (14.2 ms). GPGPU-Sim's built-in 50,000 cycles (35 us)
#    fires falsely on HBF: a non-posted 200 us NAND program stalls stores for ~282,000 cycles
#    (HBF-Sim's own reads/writes/scaling configs switch the check off for that reason). The window
#    is ~70x the longest legitimate HBF stall, so real hangs are still caught. Timing is unaffected.
-gpgpu_deadlock_detect 1
-gpgpu_deadlock_window 20000000

# 6. Ramulator's fixed front-end latency (134.75 ns) is a pipeline, as GPGPU-Sim's own
#    -dram_latency queue is in HBF-Sim: requests waiting it out are bounded only by the 257 GPU
#    credits. Otherwise they would also occupy the bridge's 128-entry buffer, capping a channel at
#    128 x 32 B / 134.75 ns = 30 GB/s (63% of 48.4). With 8 SMs that cap never binds (Qwen3
#    q_proj: 149 GB/s either way), but it must not be able to.
-gpgpu_ramulator_frontend_pipeline 1

# ---- C2_hbf_dram/config.overrides
# C2: GPU + HBF + DRAM, HBF-Sim (its Qwen3 configuration), with Ramulator in place of
# GPGPU-Sim's built-in DRAM. Attach 0 = HBF-Sim's attachment: HBF requests leave the L2
# through the shared L2->DRAM queue, take the partition's DRAM credits (257) and are handed
# to the HBF controller by hbf_cycle(); HBF data bypasses the L2 (-gpgpu_hbf_l2_policy 0).
# No prefetcher.
-gpgpu_hbf_enabled 1
-gpgpu_hbf_attach 0
-gpgpu_hbf_l2_policy 0
# One change to HBF-Sim: HBF requests pay the GPU front end (MC + PHY), 134.75 ns = HBF-Sim's
# -dram_latency 190 core cycles at 1410 MHz, like the DRAM requests of the same GPU and the HBF
# requests of C3/C4. HBF-Sim models the GPU-HBF link as bandwidth only (no latency); the
# validation runs C2 with 0 as well and checks it against HBF-Sim verbatim.
-gpgpu_hbf_frontend_latency_ns 134.751773
